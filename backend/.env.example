# --- LLM ---
GEMINI_API_KEY=

# --- Vector DB (local/embedded by default — zero cost, no external service) ---
# Leave QDRANT_URL empty to use an on-disk embedded Qdrant instance (./qdrant_data).
# Set QDRANT_URL (e.g. a free Qdrant Cloud cluster) only when you need a hosted instance.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=sanjivani_docs

# --- Database ---
# SQLite by default (zero setup, zero cost). Swap for a Postgres URL later without code changes
# beyond models/database.py's connection string.
DATABASE_URL=sqlite:///sanjivani.db

# --- Admin auth (simple shared-secret token, not full user auth — see README for upgrade path) ---
ADMIN_TOKEN=change-me-to-a-long-random-string

# --- App ---
FLASK_ENV=development
UPLOAD_DIR=../documents
MAX_UPLOAD_MB=20
